APP_ENV=development
# Optional: load and probe PEFT before opening the HTTP listener.
NLU_PRELOAD=false
# Demo: both local PEFT models share the GPU; old weights are evicted on switching.
PEFT_SEQUENTIAL=false
NLU_TIMEOUT_SECONDS=12
RAG_GENERATION_TIMEOUT_SECONDS=15
BACKEND_BASE_URL=http://127.0.0.1:8080
# Optional: use reviewed repository configs instead of the packaged fallback copies.
CONFIG_DIR=configs
# All business tools remain OFF until explicit reviewed PASS gates.
# Docker Compose only: use the configs directory created by the live verifier.
# AI_REVIEWED_CONFIG_DIR=./artifacts/local-public-search/configs
# Optional model providers; defaults remain rule/extractive until live evaluation.
# Large model/cache bind mounts resolve inside this checkout on D:, not Docker volumes.
# AI_MODEL_CACHE_DIR=./artifacts/model-cache
# AI_OLLAMA_HOME=./artifacts/ollama-home
# Native PowerShell: . ./scripts/set-local-storage.ps1 before installing dependencies.
# Docker images/build cache still use Docker Desktop's separate disk image location.
# NLU_BACKEND=llama_cpp
# NLU_CONTRACT=checkpoint_v1_2
# RAG_BACKEND=llama_cpp
# LLAMA_NLU_BASE_URL=http://llama-nlu:8080
# LLAMA_RAG_BASE_URL=http://llama-rag:8080
# POLICY_BACKEND=http
# KNOWLEDGE_BASE_URL=http://knowledge-reader:8010
# KNOWLEDGE_SERVICE_TOKEN=<server-held random token, at least 32 characters>
